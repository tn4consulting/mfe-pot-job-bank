{
  "name": "job-bank",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/job-bank/src",
  "tags": [
    "type:app",
    "scope:job-bank"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "production",
      "outputs": ["{workspaceRoot}/dist/apps/job-bank"],
      "cache": true,
      "inputs": ["production", "^production"],
      "options": {
        "command": "node apps/job-bank/build/build.mjs",
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "production": {
          "command": "node apps/job-bank/build/build.mjs"
        },
        "development": {
          "command": "node apps/job-bank/build/build.mjs --dev"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "node apps/job-bank/build/serve.mjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/job-bank/jest.config.cts",
        "tsConfig": "apps/job-bank/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "job-bank:build",
        "staticFilePath": "dist/apps/job-bank/browser",
        "spa": true,
        "port": 4203
      }
    }
  }
}
